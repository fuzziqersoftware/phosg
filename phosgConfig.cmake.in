@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/phosg.cmake")

# phosg-async is only built (and hence only exported) if asio was available at build time, so it's an optional
# component of this package. Use find_package(phosg REQUIRED COMPONENTS async) to require it.
if(TARGET phosg::phosg-async)
  set(phosg_async_FOUND TRUE)
else()
  set(phosg_async_FOUND FALSE)
endif()

check_required_components(phosg)
